# Phase 2 cloud retrieval. Replace the project ID before running cloud commands.
GOOGLE_CLOUD_PROJECT=replace-with-your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash
# Tested generation profile: global. Singapore remains the deployment/storage intent.
# Gemini 3.8 Flash lists global/us/eu endpoints, not asia-southeast1.
# Singapore generation requires supported-region and project-access verification.
# This does not change the region of an existing Firestore database or Cloud Run service.
# Embeddings use their own endpoint, independently of the generation model location.
EMBEDDING_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Cloud retrieval settings from docs/RETRIEVAL.md.
KNOWBRIDGE_STORE=firestore
# Local mode is deterministic evidence lookup with no Gemini synthesis.
# Cloud Run requires vertex and firestore; unavailable cloud services never fall back.
KNOWBRIDGE_RETRIEVAL=vertex
# To use the local deterministic adapter, change BOTH settings to file/local.
# File storage location is unused while KNOWBRIDGE_STORE=firestore.
KNOWBRIDGE_DATA_DIR=.data/sources
FIRESTORE_DATABASE_ID=(default)
# Local auth: run `gcloud auth application-default login` (user ADC). No key file;
# leave GOOGLE_APPLICATION_CREDENTIALS unset. Cloud Run uses its managed service identity;
# never bake credentials into an image.
# POST /api/ingest requires a revoked-token-checked Firebase ID token with claims:
# knowbridgeAdmin=true, knowbridgeTenant=demo-north-quay
# Google Picker optional/P1; do not request broad Drive scopes.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Runtime browser judge sign-in. Firebase Web API keys identify a project; membership stays server-enforced.
KNOWBRIDGE_JUDGE_SIGNIN_ENABLED=false
FIREBASE_WEB_API_KEY=

# Phase 4: off until the setup and fictional-account acceptance in docs/WORKSPACE.md pass.
KNOWBRIDGE_WORKSPACE_ENABLED=false
WORKSPACE_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
# Use Secret Manager at runtime; never commit the populated secret.
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Dedicated symmetric Cloud KMS key. Runtime needs key-scoped encrypter/decrypter permission.
WORKSPACE_KMS_KEY=
# Comma-separated verified Google OIDC subjects of dedicated fictional demo accounts.
WORKSPACE_ALLOWED_SUBJECTS=
# JSON array, max 3: [{"fileId":"...","sourceId":"HBR-DOC-04","subject":"..."}]
# Only registered files whose export matches the deterministic evaluation seed are accepted.
WORKSPACE_REGISTRY_JSON=
