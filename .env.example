# Choose a model available in your Google Cloud project and supported region.
GOOGLE_CLOUD_PROJECT=replace-with-your-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=replace-with-available-flash-model
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Local defaults to file storage. Cloud Run requires firestore.
KNOWBRIDGE_STORE=file
KNOWBRIDGE_DATA_DIR=.data/sources
FIRESTORE_DATABASE_ID=(default)
# Local only: set ADC with GOOGLE_APPLICATION_CREDENTIALS pointing at an ignored key.
# Cloud Run uses its managed service identity; never include this path in an image.
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/gcp-sa.json
# POST /api/ingest requires a revoked-token-checked Firebase ID token with claims:
# knowbridgeAdmin=true, knowbridgeTenant=demo-north-quay
# Google Picker optional/P1; do not request broad Drive scopes.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# This is a scaffold; Gemini/Firestore/Workspace features are TODOs for Codex.
